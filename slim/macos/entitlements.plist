<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions for the bundled CPython (slim/macos/sign_tree.py, #140).
  allow-unsigned-executable-memory: ctypes/libffi closures and cffi callbacks write code.
  disable-library-validation: extension modules a user adds later (pip into a venv made from
  this interpreter, plugins) are not signed by our team; without it CPython could not load them.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
